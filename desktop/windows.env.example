# Copy these into `.env` on Windows and adjust paths for your machine.

OPENCLAW_HOME=C:\Users\<you>\.openclaw
OPENCLAW_CONFIG_PATH=C:\Users\<you>\.openclaw\openclaw.json
OPENCLAW_WORKSPACE_ROOT=D:\OpenClaw\workspace

# Optional: use semicolon-separated Windows paths when overriding skill roots.
OPENCLAW_SKILL_ROOTS=C:\Users\<you>\.openclaw\skills;C:\Users\<you>\.codex\skills;C:\Users\<you>\.agents\skills

READONLY_MODE=true
LOCAL_TOKEN_AUTH_REQUIRED=true
LOCAL_API_TOKEN=<set-a-long-random-local-token>

# The doctor treats this as a user-confirmed setting.
# Leave unset unless Windows long path support is actually enabled.
# OPENCLAW_ASSUME_LONG_PATHS_ENABLED=true
